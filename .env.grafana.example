# Copy to .env.grafana and fill in your Grafana Cloud metrics connection details.
# The URL ends with /api/prom/push; this is not your Grafana dashboard URL.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_PROM_TOKEN=

# Backend running on your Windows host. For a deployed backend, use its hostname
# (no URL scheme or path) and set CAREMIND_METRICS_SCHEME=https.
CAREMIND_METRICS_TARGET=host.docker.internal:8002
CAREMIND_METRICS_SCHEME=http
# Match CAREMIND_USERNAME / CAREMIND_PASSWORD if API basic auth is enabled.
CAREMIND_METRICS_USERNAME=
CAREMIND_METRICS_PASSWORD=
