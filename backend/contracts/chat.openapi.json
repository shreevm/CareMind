{
  "openapi": "3.1.0",
  "info": {
    "title": "CareMind Chat API",
    "version": "0.6.0",
    "description": "Chat endpoint contract for CareMind agentic medical RAG assistant."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "summary": "Send a user message to the CareMind agent.",
        "operationId": "postChat",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful chat response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "403": {
            "description": "Attachment ID is not available to the requested workspace/session."
          }
        }
      }
    },
    "/speech/transcribe": {
      "post": {
        "summary": "Transcribe uploaded voice input with ElevenLabs Scribe v2 batch STT.",
        "operationId": "postSpeechTranscribe",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "session_id": {
                    "type": "string",
                    "default": "default"
                  },
                  "workspace_id": {
                    "type": "string",
                    "default": "default"
                  },
                  "started_at": {
                    "type": ["string", "null"],
                    "format": "date-time"
                  },
                  "ended_at": {
                    "type": ["string", "null"],
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scribe v2 transcript and detected language metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TranscriptMetadata"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": ["message", "session_id", "workspace_id"],
        "properties": {
          "message": {
            "type": "string",
            "description": "User text or transcribed voice input."
          },
          "attachment_ids": {
            "type": "array",
            "description": "Conversation-scoped attachment IDs returned from /upload and bound to this user message after authorization.",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "session_id": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          },
          "modality": {
            "type": "string",
            "enum": ["text", "voice", "image", "document"],
            "default": "text"
          },
          "transcript": {
            "$ref": "#/components/schemas/TranscriptMetadata"
          },
          "response_language": {
            "type": ["string", "null"],
            "description": "Effective answer language chosen from session override or detected voice language."
          },
          "top_k": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "default": 5
          }
        }
      },
      "TranscriptMetadata": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "language": {
            "type": "string"
          },
          "detected_language": {
            "type": ["string", "null"],
            "description": "Language code returned by ElevenLabs Scribe v2 automatic language detection."
          },
          "language_confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          },
          "timestamps": {
            "type": "array",
            "description": "Word-level Scribe timestamps preserved from the original transcript.",
            "items": {
              "type": "object"
            },
            "default": []
          },
          "modality": {
            "type": ["string", "null"],
            "default": "voice"
          },
          "input_modality": {
            "type": "string"
          }
        }
      },
      "Citation": {
        "type": "object",
        "required": ["source_id", "quote"],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "document_name": {
            "type": "string"
          },
          "chunk_id": {
            "type": "string"
          },
          "page": {
            "type": ["integer", "null"]
          },
          "score": {
            "type": ["number", "null"]
          },
          "quote": {
            "type": "string"
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": ["answer", "route", "citations"],
        "properties": {
          "answer": {
            "type": "string"
          },
          "route": {
            "type": "string"
          },
          "citations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Citation"
            }
          },
          "safety_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trace": {
            "type": "object"
          }
        }
      }
    }
  }
}
